<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingTop="12dp"
    android:paddingBottom="32dp">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/drag_handle_bg" />

    <!-- Close button -->
    <ImageButton
        android:id="@+id/btn_close_bottom_sheet"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/round_bg_dark"
        android:src="@drawable/ic_close"
        android:padding="8dp"
        android:contentDescription="Close"
        android:scaleType="centerInside"
        app:tint="@color/white" />

    <!-- SCAN MODE label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⛶ SCAN MODE"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp" />

    <!-- Single / Multi scan cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:weightSum="2">

        <FrameLayout
            android:id="@+id/card_single_scan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/scan_mode_selected_bg"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_scan"
                    app:tint="#3D8BFF"
                    android:contentDescription="Single scan" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Single Scan"
                        android:textColor="#3D8BFF"
                        android:maxLines="1"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/txt_single_scan_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="One at a time"
                        android:maxLines="1"
                        android:textColor="#99FFFFFF"
                        android:textSize="10sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ic_single_scan_check"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tick"
                    app:tint="#3D8BFF"
                    android:contentDescription="Selected" />

            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/card_multi_scan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/scan_mode_unselected_bg"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_multi_scan"
                    app:tint="@color/white"
                    android:contentDescription="Multi scan" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Multi Scan"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/txt_multi_scan_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan many at once"
                        android:textColor="#99FFFFFF"
                        android:maxLines="1"
                        android:textSize="10sp" />

                </LinearLayout>
                <ImageView
                    android:id="@+id/ic_multi_scan_check"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tick"
                    app:tint="#3D8BFF"
                    android:contentDescription="Selected" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp" />

    <!-- Verify Authenticity row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/shield_icon_bg">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tick"
                app:tint="@color/white"
                android:contentDescription="Verify" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verify Authenticity"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/txt_verify_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enabled — barcodes will be authenticated"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_verify_authenticity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:theme="@style/BlueSwitch"
            android:contentDescription="Toggle Verify Authenticity" />

    </LinearLayout>

    <!-- Auth status indicator -->
    <LinearLayout
        android:id="@+id/auth_status_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp">

        <View
            android:id="@+id/auth_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/green_dot_bg" />

        <TextView
            android:id="@+id/txt_auth_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Authentication active"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>